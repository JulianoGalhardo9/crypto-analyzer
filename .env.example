# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto
POSTGRES_DB=crypto_analyzer
DATABASE_URL=postgresql+psycopg://crypto:crypto@localhost:5433/crypto_analyzer

# Airflow (opcionais; os padrões servem para uso local)
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_WWW_USER=airflow
AIRFLOW_WWW_PASSWORD=airflow

# Telegram (used from the bot / alerts steps onward)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
